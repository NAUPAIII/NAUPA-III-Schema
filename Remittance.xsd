                                    <xs:element name="ItemIssueState" type="StateCodeType" minOccurs="0" />
                                  </xs:sequence>
                                </xs:complexType>
                              </xs:element> <!-- Cash -->
                              <!-- Section 4.4.3.2.10 Bond Element -->
