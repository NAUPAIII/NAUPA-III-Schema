      <!-- Mineral Interests -->
      <xs:enumeration value="MI01">
        <xs:annotation>
          <xs:documentation>Investment in oil and gas drilling operations in which the investor is directly liable for a portion of the ongoing costs associated with exploration, drilling, and production.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MI02">
        <xs:annotation>
          <xs:documentation>Royalty interests retained in the output of a property when the owner of mineral rights enters into a lease agreement. A royalty interest entitles the mineral rights owner to receive a portion of the minerals produced or a portion of the gross revenue from sold production.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MI03">
        <xs:annotation>
          <xs:documentation>Interests in and royalty on the oil, gas, or minerals extracted from another's land that is carved out of the producer's working interest and is not tied to production costs.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MI04">
        <xs:annotation>
          <xs:documentation>Economic interests in oil, gas or mineral reserves which (i) entitles the holder thereof to a specified share of future production from such reserves, free of the costs and expenses of such production, and (ii) terminates when a specified quantity of such share of future production from such reserves has been delivered or a specified sum has been realized from the sale of such share of future production from such reserves.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MI05">
        <xs:annotation>
          <xs:documentation>Working Interest</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MI06">
        <xs:annotation>
          <xs:documentation>Lease Bonus paid by the lessee for the execution of an oil and gas lease by a landowner. It is usually a cash consideration based on a per acre payment.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MI07">
        <xs:annotation>
          <xs:documentation>Yearly payment made to the lessor by the lessee during the primary term of the lease to compensate for drilling that is delayed.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MI08">
        <xs:annotation>
          <xs:documentation>Payment stipulated in an oil and gas lease, which royalty owners receive in lieu of actual production, when a gas well is shut-in due to lack of a suitable market, a lack of facilities to produce the product, or other cases defined within the shut-in provisions contained in the oil and gas lease.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MI09">
        <xs:annotation>
          <xs:documentation>Minimum Royalties</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MI10">
        <xs:annotation>
          <xs:documentation>Additional amounts that accrue in subsequent years after you have remitted money on behalf of an owner must also be reported. You must hold monthly checks and include them on your annual report.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MI12">
