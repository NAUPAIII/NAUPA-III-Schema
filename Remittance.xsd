                                    </xs:element>
                                  </xs:sequence>
                                </xs:complexType>
                              </xs:element> <!-- MineralInterests -->
                              <!-- Section 4.4.3.2.14 Cryptocurrency Element -->
                              <xs:element name="Cryptocurrency">
