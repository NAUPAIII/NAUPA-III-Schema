                                      </xs:simpleType>
                                    </xs:element>
                                  </xs:sequence>
                                </xs:complexType>
                              </xs:element> <!-- Bond -->
                              <!-- Section 4.4.3.2.11 Security Element -->
                              <xs:element name="Security">
                                <xs:complexType>
                                  <xs:sequence>
                                    <!-- Section 4.4.3.2.11.1 Security TypeCode Element Values -->
