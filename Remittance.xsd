        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DC13">
        <xs:annotation>
          <xs:documentation>Payment of a participant's entire balance in a pension plain, paid as an alternative to required minimum distributions.</xs:documentation>
        </xs:annotation>
